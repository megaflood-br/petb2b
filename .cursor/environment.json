{
  "name": "petb2b",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "app",
      "command": "php artisan serve --host=0.0.0.0 --port=8000"
    },
    {
      "name": "vite",
      "command": "npm run dev"
    }
  ],
  "ports": [8000, 5173]
}
